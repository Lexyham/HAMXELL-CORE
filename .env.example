
# -- App --
NODE_ENV=production
APP_URL=https://hamxellcore.zevcloud.net
APP_NAME=HAMXELL CORE
SESSION_SECRET=                # 64+ char random
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_PASSWORD=      # change on first login

# -- Supabase (primary DB + auth + storage fallback) --
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=hamxell-assets

# -- MongoDB (hot store) --
MONGODB_URI=
MONGODB_DB=hamxell_core

# -- TiDB Cloud (cold archive, 5 clusters) --
TIDB_PORT=4000
TIDB_CLUSTER_A_HOST=
TIDB_CLUSTER_A_USER=
TIDB_CLUSTER_A_PASS=
TIDB_CLUSTER_A_DB=
TIDB_CLUSTER_B_HOST=
TIDB_CLUSTER_B_USER=
TIDB_CLUSTER_B_PASS=
TIDB_CLUSTER_B_DB=
TIDB_CLUSTER_C_HOST=
TIDB_CLUSTER_C_USER=
TIDB_CLUSTER_C_PASS=
TIDB_CLUSTER_C_DB=
TIDB_CLUSTER_D_HOST=
TIDB_CLUSTER_D_USER=
TIDB_CLUSTER_D_PASS=
TIDB_CLUSTER_D_DB=
TIDB_CLUSTER_E_HOST=
TIDB_CLUSTER_E_USER=
TIDB_CLUSTER_E_PASS=
TIDB_CLUSTER_E_DB=

# -- ZevCloud (hosting + S3 storage) --
ZEVCLOUD_APP_URL=
ZEVCLOUD_S3_ENDPOINT=
ZEVCLOUD_S3_REGION=
ZEVCLOUD_S3_BUCKET=hamxell-core
ZEVCLOUD_S3_ACCESS_KEY=
ZEVCLOUD_S3_SECRET_KEY=

# -- Redis (queue + cache) --
REDIS_URL=

# -- Brevo (email) --
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@hamxellcore.com
BREVO_SENDER_NAME=HAMXELL CORE
BREVO_ADMIN_NOTIFY_EMAIL=

# -- AI providers --
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
AI_DEFAULT_PROVIDER=gemini
AI_MAX_TOKENS_PER_CALL=4096
AI_TIMEOUT_MS=60000
# Model IDs change often; check each provider's model list before deploying.
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=openrouter/auto

# -- Security / vault (each: 32-byte base64) --
VAULT_MASTER_KEY=
MFA_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

# -- Crawler / importer --
CRAWLER_USER_AGENT=HAMXELL-CORE-Importer/1.0
CRAWLER_TIMEOUT_MS=10000
CRAWLER_MAX_BYTES=5242880
CRAWLER_BLOCK_PRIVATE_IPS=true

# -- Importer (website audit) --
# Optional: a GitHub token raises the public API limit for repository reviews (60 requests per hour without one)
GITHUB_TOKEN=
IMPORTER_MAX_PAGES=6           # pages reviewed per audit (the start page plus up to N-1 more)
IMPORTER_LINK_CHECKS=20        # further internal links whose status is checked
IMPORTER_DEADLINE_MS=60000     # the review stops early after this long

# -- Cron over HTTP (optional) --
# For hosts that cannot run the worker process. Schedule GET/POST /api/cron/archive with Authorization: <CRON_SECRET>
# Leave empty to disable the endpoint.
CRON_SECRET=

# -- Archiver --
ARCHIVE_AGE_DAYS=30
ARCHIVE_CRON_INTERVAL_HOURS=6

# -- Rate limits --
RATE_LIMIT_CONTACT_PER_HOUR=5
RATE_LIMIT_CHATBOT_PER_HOUR=60
RATE_LIMIT_ADMIN_LOGIN_PER_15MIN=5

# -- Feature flags (true = live, false = "Coming Soon") --
FEATURE_CHATBOT=true
FEATURE_PROJECT_IMPORTER=true
FEATURE_AI_DOC_GENERATOR=true
FEATURE_KNOWLEDGE_ENGINE=false
FEATURE_WARNING_GATED_PROJECTS=true
FEATURE_UNLISTED_PROJECTS=true
FEATURE_CREDENTIALS_VAULT=true
FEATURE_ANALYTICS_DASHBOARD=true
FEATURE_PUBLIC_AI_ASSISTANT=false
FEATURE_LICENSING=true
