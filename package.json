{
  "name": "hamxell-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next build && next start",
    "typecheck": "tsc --noEmit",
    "bootstrap-admin": "node --env-file=.env scripts/bootstrap-admin.mjs",
    "serve": "next start",
    "keygen": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "decrypt-backup": "node --env-file=.env scripts/decrypt-backup.mjs",
    "worker": "tsx worker/index.ts",
    "worker:local": "tsx --env-file=.env worker/index.ts",
    "tidb:migrate": "tsx --env-file=.env scripts/tidb-migrate.ts",
    "test:overflow": "node scripts/check-overflow.mjs"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "gsap": "^3.12.5",
    "lenis": "^1.1.0",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "server-only": "^0.0.1",
    "pdf-lib": "^1.17.1",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "mongodb": "^6.8.0",
    "ioredis": "^5.4.0",
    "mysql2": "^3.11.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "playwright": "^1.47.0"
  }
}